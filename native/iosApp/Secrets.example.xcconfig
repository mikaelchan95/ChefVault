// Copy this file to `Secrets.xcconfig` (gitignored) and fill in real values.
//
// IMPORTANT: xcconfig treats `//` as a comment, so DO NOT put the `https://` scheme
// here. Store only the host; the app prepends `https://` at runtime.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-public-anon-key
